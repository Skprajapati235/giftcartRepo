{
  "expo": {
    "name": "GiftFestive",
    "slug": "giftfestive-mobile",
    "version": "1.0.0",
    "sdkVersion": "55.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "icon": "./src/assets/images/GiftFestiveIcon.png",
    "backgroundColor": "#ffffff",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GiftFestive uses your location to check if we can deliver to you in Faridabad."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GiftFestive needs access to your photos so you can add a profile picture or a review photo."
        }
      ]
    ],
    "android": {
      "package": "com.giftfestive.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/GiftFestiveIcon.png",
        "backgroundColor": "#D82B76"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "com.giftfestive.app",
      "buildNumber": "1",
      "supportsTablet": false
    }
  }
}
