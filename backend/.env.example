# PORT=5000
# MONGO_URI=
# JWT_SECRET=

# # Cloudinary (profile picture / product image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # 2Factor.in — mobile OTP login (website + app)
# TWO_FACTOR_API_KEY=

# # Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# # Email (admin/user password reset OTP)
# EMAIL_USER=
# EMAIL_PASS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=

# # WhatsApp (Twilio) order/login notifications — optional
# WHATSAPP_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_FROM=
# WHATSAPP_DEFAULT_TO=
# WHATSAPP_DEFAULT_COUNTRY_CODE=+91
# WHATSAPP_SEND_ON_LOGIN=false

# # Tracking link base + AI agent (admin panel) — optional
# BASE_URL=
# TRACK_BASE_URL=
# PYTHON_AI_URL=
# AI_INTERNAL_KEY=



PORT=5000
MONGO_URI=
JWT_SECRET=

# Cloudinary (profile picture / product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 2Factor.in — mobile OTP login (website + app)
TWO_FACTOR_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (admin/user password reset OTP)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# WhatsApp (Twilio) order/login notifications — optional
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=
WHATSAPP_DEFAULT_TO=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
WHATSAPP_SEND_ON_LOGIN=false

# Tracking link base + AI agent (admin panel) — optional
BASE_URL=
TRACK_BASE_URL=
PYTHON_AI_URL=
AI_INTERNAL_KEY=

# ───── Added by the security update ─────
# Comma-separated Google emails allowed to be auto-created as admin on first Google login.
# Leave empty = Google login only works for admins that ALREADY exist.
ADMIN_GOOGLE_ALLOWED_EMAILS=
ADMIN_GOOGLE_DEFAULT_ROLE=admin
GOOGLE_CLIENT_ID=

# Razorpay webhook (Dashboard → Settings → Webhooks). URL: https://<backend>/api/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Browsers allowed to call the API (mobile app is not affected). Comma separated.
# e.g. https://giftfestive.com,https://www.giftfestive.com,https://giftcart-repo.vercel.app
CORS_ORIGINS=

# ── Sessions ──
# CUSTOMERS (website + mobile app): 365-day token that slides forward while they are active,
# so they stay logged in until they press Logout. Don't set this below 180d.
# IMPORTANT: never change JWT_SECRET casually — everybody gets logged out when it changes.
JWT_EXPIRES_IN=365d

# ADMIN PANEL (cookie sessions): short access token + rotating refresh token
ADMIN_ACCESS_TTL=15m
ADMIN_REFRESH_TTL_DAYS=7        # idle limit: log in again after 7 days without opening the panel
ADMIN_SESSION_MAX_DAYS=30       # hard limit: log in again at least every 30 days
# Path of the refresh cookie as the BROWSER sees it (admin panel proxies the API at /backend)
ADMIN_REFRESH_COOKIE_PATH=/backend/admin/auth
# Only used by old header-token clients
ADMIN_JWT_EXPIRES_IN=7d

# Signs the "change order status" links in admin emails (falls back to JWT_SECRET)
ORDER_ACTION_SECRET=

# Set to true ONLY after real stock numbers are filled in Admin → Inventory.
# true  = stock is deducted on order, out-of-stock orders are rejected, stock returns on cancel
ENFORCE_STOCK=false

# Needed in production for the Admin AI assistant (otherwise it falls back to localhost and fails)
NODE_ENV=production

# ── Decoration bookings ──
# Customers must be logged in to book. Online bookings are saved first and paid right after.
# Venue types, time slots, colour themes, notice hours, cancellation window, advance %, support numbers
# are managed in the admin: Decoration Dashboard → Booking Setup (no .env needed).
# The values below are ONLY the starting values used the very first time the backend starts; after that the
# admin dashboard is the single source of truth.
#DECORATION_UNPAID_EXPIRY_MINUTES=120
#DECORATION_MIN_LEAD_HOURS=3
#DECORATION_MAX_ADVANCE_DAYS=180
#DECORATION_CANCEL_HOURS=24
#DECORATION_MAX_UNPAID=3
#SUPPORT_WHATSAPP=918400787712
